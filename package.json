{
  "name": "regwatch",
  "version": "0.1.0",
  "private": true,
  "description": "RegWatch: мониторинг регулирования",
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --test \"src/**/*.test.ts\" \"scripts/**/*.test.mjs\"",
    "doctor": "node src/main/doctor-cli.ts",
    "app": "node scripts/app.mjs",
    "golden": "node scripts/golden.mjs",
    "audit": "node scripts/trace-audit.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "cheerio": "^1.2.0",
    "fast-xml-parser": "^5.12.1",
    "nodemailer": "^10.6.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}

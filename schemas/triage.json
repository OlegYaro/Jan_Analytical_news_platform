{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TriageOutput",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "country": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "decision": {
            "enum": [
              "relevant",
              "borderline",
              "irrelevant"
            ]
          },
          "reason_code": {
            "enum": [
              null,
              "other_sector",
              "personnel_appointment",
              "individual_decision",
              "not_regulatory",
              "duplicate_of_other_candidate",
              "outside_date_window"
            ]
          },
          "reason_text": {
            "type": "string",
            "maxLength": 200
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        },
        "required": [
          "id",
          "decision",
          "reason_code",
          "reason_text",
          "confidence"
        ],
        "if": {
          "type": "object",
          "properties": {
            "decision": {
              "const": "irrelevant"
            }
          },
          "required": [
            "decision"
          ]
        },
        "then": {
          "type": "object",
          "properties": {
            "reason_code": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "required": [
    "country",
    "items"
  ]
}

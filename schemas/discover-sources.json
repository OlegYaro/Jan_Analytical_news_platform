{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DiscoverSources",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "country": {
      "type": "string"
    },
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "enum": [
              "legal_base",
              "regulator",
              "drafts",
              "news"
            ]
          },
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "listing_url": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "name",
          "url",
          "listing_url",
          "language",
          "reason"
        ]
      }
    },
    "watched_act_proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "act_type": {
            "enum": [
              "banking_law",
              "central_bank_law",
              "joint_stock_law",
              "fx_law",
              "aml_law",
              "deposit_insurance_law",
              "cb_corporate_governance"
            ]
          },
          "title_original": {
            "type": "string"
          },
          "number": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "last_edition_date": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "const": "unknown"
              }
            ]
          },
          "quote": {
            "type": "string",
            "maxLength": 300
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "act_type",
          "title_original",
          "number",
          "url",
          "last_edition_date",
          "quote",
          "reason"
        ]
      }
    }
  },
  "required": [
    "country",
    "proposals",
    "watched_act_proposals"
  ]
}

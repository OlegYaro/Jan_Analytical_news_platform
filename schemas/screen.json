{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ScreenOutput",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "country": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "screen",
        "confirm"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "decision": {
            "enum": [
              "material",
              "minor",
              "none",
              "unsure"
            ]
          },
          "points": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "string",
              "maxLength": 300
            }
          },
          "quote": {
            "type": "string",
            "maxLength": 300
          },
          "reason": {
            "type": "string",
            "maxLength": 200
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        },
        "required": [
          "id",
          "decision",
          "points",
          "quote",
          "reason",
          "confidence"
        ]
      }
    }
  },
  "required": [
    "country",
    "mode",
    "items"
  ]
}
